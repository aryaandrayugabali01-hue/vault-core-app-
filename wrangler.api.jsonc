{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-core-api",
  "main": "cloudflare/vault-core-api.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "97e2993f7733422abd08bfbf699ce4e4"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
