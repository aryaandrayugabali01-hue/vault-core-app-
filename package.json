{
  "name": "vault-core-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VAULT CORE Telegram Mini App single-vendor store",
  "workspaces": [
    "backend",
    "bot",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "start:backend": "npm --workspace backend start",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "test": "npm --workspace backend test",
    "setup:webhook": "node bot/bot.js",
    "migrate": "npm --workspace backend run migrate"
  }
}
